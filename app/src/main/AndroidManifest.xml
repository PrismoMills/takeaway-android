<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.order">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="com.example.order.MyApplication"
        android:icon="@mipmap/logo"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="AllowBackup"
        tools:targetApi="n">
        <activity
            android:name="com.example.order.activity.OrderActivity"
            android:parentActivityName="com.example.order.activity.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.example.order.activity.MainActivity" />
        </activity>
        <activity
            android:name="com.example.order.activity.LoginActivity"
            android:parentActivityName="com.example.order.activity.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.example.order.activity.MainActivity" />
        </activity>
        <activity
            android:name="com.example.order.activity.RegisterActivity"
            android:parentActivityName="com.example.order.activity.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.example.order.activity.RegisterActivity" />
        </activity>
        <activity
            android:name="com.example.order.activity.DetailActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="com.example.order.activity.WelcomeActivity"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.example.order.activity.MainActivity"
            android:label="@string/app_name"
            android:launchMode="singleTask" />
    </application>

</manifest>
