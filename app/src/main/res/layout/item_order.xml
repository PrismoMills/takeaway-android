<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="10dp" android:padding="16dp"
    android:orientation="vertical" android:background="@drawable/detail_info">
    <TextView android:id="@+id/orderName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textStyle="bold"
        android:textSize="18sp" android:textColor="@color/ink"/>
    <TextView android:id="@+id/orderTime" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:textColor="@color/muted"/>
    <TextView android:id="@+id/orderItems" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:textColor="@color/ink"/>
    <TextView android:id="@+id/orderMoney" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:textStyle="bold" android:textColor="@color/colorPrimary"/>
</LinearLayout>
